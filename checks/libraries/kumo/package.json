    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "esbuild": "0.28.2"
  }
}
